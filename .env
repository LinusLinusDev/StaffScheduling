# Demo version: the fictional demo station (api/app/demo.py) instead of the TimeOffice database.
DATA_SOURCE=demo
SOLVER_BACKEND=gurobi
# Fixed solver time of every schedule in seconds: good plans come within 20, the rest is a buffer.
SOLVER_MAX_TIME_SECONDS=40
# Solver log in `just logs`; set to false to silence it.
SOLVER_LOG_SEARCH_PROGRESS=true
